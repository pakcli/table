{
	"name": "pakcli-table",
	"version": "1.0.0",
	"description": "Visual tables, interactive SQL database explorer, ASCII canvas drawing, and interactive Leaflet maps.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node --no-deprecation esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node --no-deprecation esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint ."
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"tables",
		"sql",
		"sqlite",
		"leaflet",
		"ascii",
		"diagrams"
	],
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "9.30.1",
		"@types/node": "^22.15.17",
		"esbuild": "^0.25.9",
		"esbuild-plugin-polyfill-node": "^0.3.0",
		"esbuild-sass-plugin": "^3.3.1",
		"eslint": "^9.0.0",
		"eslint-plugin-obsidianmd": "0.1.9",
		"globals": "14.0.0",
		"jiti": "2.6.1",
		"obsidian": "latest",
		"sass": "^1.83.4",
		"typescript": "~5.8.3",
		"typescript-eslint": "8.35.1"
	},
	"dependencies": {
		"@ag-grid-community/theming": "^32.3.9",
		"@codemirror/language": "^6.11.2",
		"@codemirror/state": "^6.5.2",
		"@codemirror/view": "^6.38.1",
		"@preact/compat": "^17.1.0",
		"@tanstack/react-table": "^8.11.0",
		"@tanstack/react-virtual": "^3.1.0",
		"ag-grid-community": "^32.3.3",
		"esprima": "^4.0.1",
		"estraverse": "^5.3.0",
		"jschardet": "^3.1.4",
		"json5": "^2.2.3",
		"jsonpath": "^1.1.1",
		"leaflet": "^1.9.4",
		"papaparse": "^5.5.3",
		"preact": "^10.26.9",
		"sql-parser-cst": "^0.44.0",
		"sqlocal": "^0.13.0",
		"unidecode": "^1.1.0",
		"wa-sqlite": "^1.0.3"
	}
}
